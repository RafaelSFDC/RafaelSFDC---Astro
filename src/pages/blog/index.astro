---
import Layout from '../../layouts/Layout.astro';
import HeroHeader from '../../components/header.tsx';
import Footer from '../../components/footer.tsx';
import { BlogsList } from '../../components/blog/blogs-list.tsx';
import { getAllPosts } from '../../lib/blog.ts';
import { FileText } from 'lucide-react';

const posts = getAllPosts([
  'title',
  'date',
  'slug',
  'author',
  'coverImage',
  'excerpt',
  'category',
  'tags',
  'featured',
]);

const featuredPost = posts.find((p) => p.featured) || posts[0];
const regularPosts = posts.filter((p) => p.slug !== featuredPost?.slug);
---

<Layout
  title="Blog sobre SEO Técnico, Performance e Estratégia Digital"
  description="Artigos sobre SEO técnico, desenvolvimento web, performance, segurança e estratégias digitais para crescer com tecnologia."
  canonical="/blog"
>
  <div class="min-h-screen bg-background text-on-surface">
    <HeroHeader navigationMode="blog" client:load />
    <main class="pt-20">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap">
        <div class="flex items-center gap-4 mb-6">
          <FileText className="size-8 text-surface-tint" />
          <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg">
            Blog Estratégico
          </h1>
        </div>
        <p class="text-on-surface-variant font-body-lg text-body-lg max-w-2xl mb-16">
          Aprenda estratégias práticas para vender mais e crescer sua presença online.
        </p>

        <BlogsList
          client:load
          initialFeaturedPost={featuredPost}
          initialRegularPosts={regularPosts}
          allPosts={posts}
        />

        <div class="glass-card p-12 md:p-16 rounded-2xl text-center relative overflow-hidden mt-section-gap">
          <div class="absolute top-0 left-0 w-full h-full glow-bg opacity-30 pointer-events-none"></div>
          <div class="max-w-2xl mx-auto space-y-4 relative">
            <span class="font-label-sm text-label-sm text-surface-tint uppercase tracking-widest mb-2 block">
              Newsletter
            </span>
            <h3 class="font-headline-md text-headline-md">
              Receba conteúdos semanais na sua caixa de entrada
            </h3>
            <p class="text-on-surface-variant">
              Junte-se a mais de 10.000 empreendedores que recebem nossas dicas de gestão e e-commerce.
            </p>
            <p class="text-xs text-on-surface-variant/60 pt-2">
              Sem spam. Cancele quando quiser.
            </p>
          </div>
        </div>
      </div>
    </main>
    <Footer navigationMode="blog" />
  </div>
</Layout>
