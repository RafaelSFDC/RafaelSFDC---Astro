---
import Layout from '../../layouts/Layout.astro';
import HeroHeader from '../../components/header.tsx';
import Footer from '../../components/footer.tsx';
import { MarkdownRenderer } from '../../components/blog/markdown-renderer.tsx';
import { FAQSection } from '../../components/blog/content/FAQSection.tsx';
import { ShareButtons } from '../../components/blog/layout/ShareButtons.tsx';
import { getAllPosts, getPostBySlug } from '../../lib/blog.ts';
import { extractFAQFromMarkdown } from '../../lib/extract-faq.ts';
import { formatDate } from '../../lib/utils.ts';
import { ArrowLeft, Calendar, Clock } from 'lucide-react';

export function getStaticPaths() {
  const posts = getAllPosts(['slug']);
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = getPostBySlug(slug, [
  'title',
  'date',
  'coverImage',
  'coverImageAlt',
  'excerpt',
  'content',
  'author',
  'category',
  'tags',
  'seo',
]);
const faqItems = extractFAQFromMarkdown(post.content || '');
// O MDX original compilava <FAQSection>/<WebStory> como componentes (WebStory=null).
// O react-markdown escaparia esses blocos como texto visível, então removemos
// do corpo — o FAQ já é renderizado pela island dedicada abaixo.
const cleanContent = (post.content || '')
  .replace(/<FAQSection[\s\S]*?\n\/>/g, '')
  .replace(/<WebStory>[\s\S]*?<\/WebStory>/g, '');
const readingMinutes = Math.max(1, Math.round((post.content || '').split(/\s+/).length / 200));
const SITE_URL = import.meta.env.PUBLIC_APP_URL || 'https://rafaelsfcarvalho.vercel.app';
const postUrl = `${SITE_URL}/blog/${slug}`;
const metaTitle = post.seo?.title || post.title;
const metaDescription = post.seo?.description || post.excerpt;
---

<Layout title={metaTitle} description={metaDescription} canonical={`/blog/${slug}`} ogImage={post.coverImage} ogType="article">
  <div class="min-h-screen bg-background text-on-surface">
    <HeroHeader navigationMode="blog" client:load />
    <main class="pt-20">
      <article class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap">
        <a href="/blog" class="inline-flex items-center gap-2 text-on-surface-variant hover:text-surface-tint transition-colors mb-8 font-label-sm text-label-sm uppercase tracking-widest">
          <ArrowLeft className="size-4" /> Voltar ao blog
        </a>
        <p class="font-label-sm text-label-sm text-surface-tint mb-3 uppercase tracking-wider">{post.category}</p>
        <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-6 max-w-4xl">{post.title}</h1>
        <p class="text-on-surface-variant font-body-lg text-body-lg max-w-2xl mb-8">{post.excerpt}</p>
        <div class="flex flex-wrap items-center gap-6 text-sm text-on-surface-variant mb-10">
          <span class="inline-flex items-center gap-2"><Calendar className="size-4" />{formatDate(post.date)}</span>
          <span class="inline-flex items-center gap-2"><Clock className="size-4" />{readingMinutes} min de leitura</span>
          <span>Por {post.author?.name}</span>
        </div>
        {post.coverImage && (
          <img src={post.coverImage} alt={post.coverImageAlt || post.title} class="w-full h-auto rounded-2xl border border-white/10 mb-12" />
        )}
        <div class="max-w-3xl">
          <MarkdownRenderer content={cleanContent} client:load />
          {faqItems.length > 0 && (
            <div class="mt-16">
              <FAQSection title="Perguntas Frequentes" items={faqItems} client:load />
            </div>
          )}
          <div class="mt-12">
            <ShareButtons url={postUrl} title={post.title} client:load />
          </div>
        </div>
      </article>
    </main>
    <Footer navigationMode="blog" />
  </div>
  {faqItems.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((f: any) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    })} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: metaDescription,
    image: post.coverImage,
    datePublished: post.date,
    author: { "@type": "Person", name: post.author?.name || "Rafael SFDC" },
    mainEntityOfPage: postUrl,
  })} />
</Layout>

