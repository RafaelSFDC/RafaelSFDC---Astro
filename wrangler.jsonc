{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "rafaelsfdc---astro",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_APP_URL": "https://rafaelsfcarvalho.com"
  },
  "routes": [
    {
      "pattern": "rafaelsfcarvalho.com",
      "custom_domain": true
    },
    {
      "pattern": "www.rafaelsfcarvalho.com",
      "custom_domain": true
    }
  ]
}
